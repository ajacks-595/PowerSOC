# PowerSOC environment configuration
# Copy to .env and fill in your values. The systemd unit sources this file.
# Every credential here can alternatively be set via the first-run /setup
# wizard (values entered in the UI take precedence).
#
# Format: comments go on their OWN line. A blank value means "unset" (the
# built-in default applies). Quote values that contain spaces or '#'.

# --- Sunsynk ---
# Your sunsynk.net login email / password
SUNSYNK_USERNAME=
SUNSYNK_PASSWORD=
# Inverter serial (Sunsynk Connect -> Equipment -> Inverter)
SUNSYNK_INVERTER_SN=
# Plant ID (visible in the URL when viewing your plant)
SUNSYNK_PLANT_ID=

# --- Octopus Energy ---
# API key from https://octopus.energy/dashboard/developer/
OCTOPUS_API_KEY=
# Account number, format A-XXXXXXXX (shown on bills / dashboard)
OCTOPUS_ACCOUNT_NUMBER=
# The following are auto-discovered from the account API if left blank:
OCTOPUS_MPAN=
OCTOPUS_METER_SERIAL=
OCTOPUS_EXPORT_MPAN=
OCTOPUS_EXPORT_SERIAL=
OCTOPUS_MPRN=
OCTOPUS_GAS_SERIAL=

# --- Notifications ---
# Incoming webhook URL from your Mattermost instance (http/https only)
MATTERMOST_WEBHOOK_URL=
# Channel handle; blank = the channel the webhook was created against
MATTERMOST_CHANNEL=

# --- Application ---
# Bind address / port (dev-server and host path; Docker maps ports in compose)
POWERSOC_HOST=0.0.0.0
POWERSOC_PORT=8073
POWERSOC_DATA_DIR=/opt/powersoc/data
# Optional explicit DB path (default: DATA_DIR/powersoc.db)
POWERSOC_DB_PATH=
# Optional log path override
POWERSOC_LOG_PATH=
# Set to 1 when behind an HTTPS reverse proxy
POWERSOC_COOKIE_SECURE=0
# Signed-session lifetime (days)
POWERSOC_SESSION_DAYS=30
POWERSOC_DEFAULT_THEME=dark
# Set to 1 ONLY behind a trusted reverse proxy (Traefik/Runtipi/nginx): the
# per-IP login throttle + audit log then use X-Forwarded-For. Leave 0 on a
# direct bind, or clients can spoof XFF to dodge the throttle.
POWERSOC_TRUST_PROXY=0
# 'prod' or 'dev' (default: auto-detect from the install path)
POWERSOC_RUNTIME=
LOG_LEVEL=INFO
TZ=Europe/London

# --- First-run setup ---
# While no users exist, /setup requires a one-time token. If unset, one is
# generated and printed in the log at startup (grep "setup token").
POWERSOC_SETUP_TOKEN=

# --- Encryption key (credentials at rest) ---
# RECOMMENDED: keep the Fernet key seed OUTSIDE the data directory so a copied
# or lost data volume can't be decrypted / doesn't take the key with it.
# Either set the secret directly, or point at a file holding it (Docker
# secret / host bind mount). If _FILE is set but missing, startup FAILS rather
# than silently using a different key. Changing either later invalidates all
# stored credentials (re-enter them in Settings).
POWERSOC_MACHINE_ID=
POWERSOC_MACHINE_ID_FILE=
# Optional: override the per-deployment crypto salt (same caveat as above)
POWERSOC_FERNET_SALT=

# --- Backups ---
# Nightly SQLite backup directory. Put it on a DIFFERENT disk / bind mount /
# synced folder than POWERSOC_DATA_DIR — the default (DATA_DIR/backups) dies
# with the data. Startup warns while backups live inside DATA_DIR.
POWERSOC_BACKUP_DIR=
# Number of daily backups kept
POWERSOC_BACKUP_KEEP=14

# --- Monitoring (dead-man's switch) ---
# URL pinged after every successful scheduler tick / master run ("/fail"
# appended on failure). Works with healthchecks.io and Uptime Kuma "push"
# monitors; alert on the ping going MISSING.
POWERSOC_HEARTBEAT_URL=

# --- Location (weather + grid-carbon region; also settable in Settings) ---
POWERSOC_WEATHER_LAT=55.0701
POWERSOC_WEATHER_LON=-3.6033
POWERSOC_WEATHER_NAME=Dumfries
# Postcode area for the regional carbon-intensity API
POWERSOC_CARBON_OUTCODE=DG

# --- Gas meter units (also settable in Settings) ---
# 'm3' (standard, converted to kWh) or 'kwh' if the meter already reports kWh
POWERSOC_GAS_UNITS=m3

# --- Sunsynk regional endpoint (rarely needed) ---
#SUNSYNK_BASE_URL=https://api.sunsynk.net

# --- Scheduling / Sunsynk call cadence (Docker deploy) ---
# 1 = run the daily + intraday sync in-app (the Docker image sets this)
POWERSOC_SCHEDULER=0
# How often today's data is refreshed (minutes)
POWERSOC_INTRADAY_MINUTES=60
# Live power-flow refresh (seconds; shared cache, ~1 Sunsynk fetch/min)
POWERSOC_LIVE_SECONDS=60
# Battery/diagnostics detail refresh (seconds)
POWERSOC_INDEPTH_SECONDS=3600

# --- Intraday Mattermost alerts (deduped once/day; needs the webhook) ---
# 0 to disable
POWERSOC_ALERTS=1
# Alert when battery SoC drops below this %
POWERSOC_ALERT_BATTERY_LOW=15
# Alert when the day's net cost exceeds this (pence)
POWERSOC_ALERT_HIGH_COST_P=500
# Alert when peak-window import exceeds this (kWh)
POWERSOC_ALERT_PEAK_KWH=2
# e.g. 22-7: suppress alerts overnight (local hours, may wrap midnight;
# suppressed alerts fire on the first tick after the window)
POWERSOC_ALERT_QUIET_HOURS=

# --- Security / experimental ---
# Per-IP failed logins before a temporary lockout, and the window (seconds)
POWERSOC_LOGIN_MAX_FAILURES=10
POWERSOC_LOGIN_WINDOW_S=300
# 1 = fetch Octoplus Saving Sessions (Kraken; experimental)
POWERSOC_SAVING_SESSIONS=0
